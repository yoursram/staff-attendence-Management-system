# Dockerfile for Jetson Nano (ARM64)
# Use NVIDIA's L4T PyTorch container as base
FROM nvcr.io/nvidia/l4t-pytorch:r35.2.1-pth2.0-py3

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    python3-opencv \
    libglib2.0-0 \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install Python dependencies
COPY requirements-jetson.txt .
RUN pip3 install fastapi uvicorn python-multipart Pillow python-dotenv aiofiles

# Try to install InsightFace (may take time to compile on ARM64)
RUN pip3 install insightface || echo "InsightFace installation failed, continuing..."

# Copy application code
COPY . .

# Create necessary directories
RUN mkdir -p uploads data/face_embeddings

# Expose port
EXPOSE 8000

# Run the application
CMD ["python3", "app.py"]
